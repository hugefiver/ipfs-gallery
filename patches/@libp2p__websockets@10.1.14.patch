--- /dev/null
+++ b/src/socket-lifecycle.ts
@@ -0,0 +1,33 @@
+const closedSockets = new WeakMap<WebSocket, Promise<void>>()
+
+/** Resolves only when the native socket is CLOSED or has emitted close. */
+export function socketClosed (websocket: WebSocket): Promise<void> {
+  let closed = closedSockets.get(websocket)
+
+  if (closed == null) {
+    closed = new Promise<void>((resolve) => {
+      if (websocket.readyState === 3) {
+        resolve()
+        return
+      }
+
+      websocket.addEventListener('close', () => { resolve() }, { once: true })
+    })
+    closedSockets.set(websocket, closed)
+  }
+
+  return closed
+}
+
+export async function closeSocket (websocket: WebSocket): Promise<void> {
+  const closed = socketClosed(websocket)
+
+  try {
+    if (websocket.readyState < 2) {
+      websocket.close()
+    }
+  } finally {
+    // A failed close call is not evidence that the native resource has exited.
+    await closed
+  }
+}
