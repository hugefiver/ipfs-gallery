{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "*.config.ts", "build/**/*.ts", "tests/support/sw-gallery-policy.ts",
    "src/shared/build-policy-defaults.ts", "src/shared/gateway-normalizer.ts",
    "src/shared/errors.ts", "src/shared/contracts.ts", "src/shared/limits.ts"
  ]
}
