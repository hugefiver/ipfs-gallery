{
  "name": "ipfs-gallery",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:reader-album": "vite build --outDir .reader-album-build",
    "preview": "vite preview",
    "preview:reader-album": "vite preview --outDir .reader-album-build --port 4183 --strictPort",
    "typecheck": "tsc -b",
    "typecheck:shared": "tsc -p tsconfig.shared.json",
    "test": "vitest run",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "test:deployment": "playwright test --config playwright.deployment.config.ts",
    "lint": "eslint . --max-warnings 0",
    "doctor:react": "react-doctor src --verbose --no-telemetry --no-supply-chain",
    "audit:browser": "playwright test --config playwright.audit.config.ts",
    "audit:support": "playwright test --config tests/audit/support.config.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "ipfs-unixfs-exporter": "^16.2.3",
    "multiformats": "^14.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@helia/bitswap": "4.0.20",
    "@helia/libp2p": "2.1.5",
    "@ipld/dag-pb": "^4.2.0",
    "@libp2p/identify": "4.1.7",
    "@libp2p/interface": "3.2.4",
    "@libp2p/noise": "17.0.2",
    "@libp2p/peer-id": "6.0.10",
    "@libp2p/websockets": "10.1.14",
    "@libp2p/yamux": "8.0.3",
    "@multiformats/multiaddr": "13.0.3",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "blockstore-core": "^7.0.1",
    "datastore-core": "12.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "helia": "7.1.16",
    "interface-blockstore": "7.0.1",
    "interface-datastore": "10.0.1",
    "ipfs-unixfs-importer": "^17.1.1",
    "libp2p": "3.3.3",
    "playwright": "^1.64.0",
    "playwright-lighthouse": "^4.0.0",
    "react-doctor": "^0.9.17",
    "react-grab": "^0.2.0",
    "react-scan": "^0.5.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
